# Copy this file to .env. Never commit the real .env file.
# Select either "groq" (default) or "elevenlabs".
MY_DICTATION_ASR_PROVIDER=groq

GROQ_API_KEY=gsk_...
# GROQ_MODEL=whisper-large-v3-turbo

# ElevenLabs Scribe (used when MY_DICTATION_ASR_PROVIDER=elevenlabs).
ELEVENLABS_API_KEY=xi-...
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# ELEVENLABS_MODEL=scribe_v1

# Optional: OpenAI or another OpenAI-compatible API.
LLM_API_KEY=...
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# Optional overrides.
# MY_DICTATION_DATA_DIR=data
